# Copy to .env.local for local dev, and set the same in Vercel → Settings →
# Environment Variables for production. Never commit real values.

# Neon / Vercel Postgres connection string.
# On Vercel this is provided automatically when you attach a Postgres database.
# For local dev, run:  vercel env pull .env.local
DATABASE_URL=

# 32+ character random string used to encrypt the admin session cookie.
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# bcrypt hash of your admin password.
# Generate:  node scripts/hash-password.mjs "your-strong-password"
ADMIN_PASSWORD_HASH=

# SHA-256 of the secret word you type to reveal the admin login.
# Generate:  node scripts/hash-word.mjs "yourword"
# (Exposed to the browser by design — it's only a hash, and the password is the real lock.)
NEXT_PUBLIC_SECRET_WORD_SHA256=
